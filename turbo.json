{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".dev.vars", ".dev.vars.*"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "CI",
        "CLOUDFLARE_*",
        "IMAGE_GITHUB_TOKEN",
        "GITHUB_TOKEN",
        "HMAC_SECRET",
        "NOTIFICATIONS_GITHUB_TOKEN",
        "NOTIFICATIONS_REPO_TOKEN"
      ]
    },
    "deploy": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": [
        "CI",
        "CLOUDFLARE_*",
        "IMAGE_GITHUB_TOKEN",
        "GITHUB_TOKEN",
        "HMAC_SECRET",
        "NOTIFICATIONS_GITHUB_TOKEN",
        "NOTIFICATIONS_REPO_TOKEN"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "cf-typegen": {
      "outputs": ["worker-configuration.d.ts"]
    }
  }
}
