{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "enabled": true,
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
  "placement": { "mode": "smart" },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "image.luxass.dev",
      "previews_enabled": false,
    },
    {
      "custom_domain": true,
      "pattern": "image.luxass.com",
      "previews_enabled": false,
    },
    {
      "custom_domain": true,
      "pattern": "previews.image.luxass.dev",
      "previews_enabled": true,
    },
    {
      "custom_domain": true,
      "pattern": "previews.image.luxass.com",
      "previews_enabled": true,
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
    },
  },
}
