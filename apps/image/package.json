    "hono-jsx-to-react": "catalog:image",
    "satori": "catalog:image",
    "zod": "catalog:prod"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:dev",
    "@cloudflare/vitest-plugin": "catalog:dev",
    "cf": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "packageManager": "pnpm@12.22.0"
}
