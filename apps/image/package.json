{
  "name": "image",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "test": "vitest --run --reporter=default --reporter=./test/image-reporter.ts",
    "test:watch": "vitest --reporter=default --reporter=./test/image-reporter.ts",
    "cf-typegen": "cf workers types",
