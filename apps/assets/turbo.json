{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "interactive": true
    },
    "build": {
      "outputs": [".cloudflare/output/**", ".cloudflare/types/**"]
    },
    "typecheck": {
      "outputs": [".cloudflare/types/**"]
    },
    "cf-typegen": {
      "outputs": [".cloudflare/types/**"]
    }
  }
}
