{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "models",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-22",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "enabled": true,
  },
  "secrets": {
    "required": ["HMAC_SECRET"],
  },
  "vars": {
    "DEFAULT_MODEL": "@cf/ibm-granite/granite-4.0-h-micro",
  },
  "placement": { "mode": "smart" },
  "routes": [
    {
      "custom_domain": true,
      "pattern": "models.luxass.dev",
      "previews_enabled": false,
    },
    {
      "custom_domain": true,
      "pattern": "models.luxass.com",
      "previews_enabled": false,
    },
    {
      "custom_domain": true,
      "pattern": "previews.models.luxass.dev",
      "previews_enabled": true,
      "enabled": false,
    },
    {
      "custom_domain": true,
      "pattern": "previews.models.luxass.com",
      "previews_enabled": true,
      "enabled": false,
    },
  ],
  "previews": {
    "ai": {
      "binding": "AI",
      "remote": true,
    },
  },
}
