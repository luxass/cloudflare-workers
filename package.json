{
  "name": "cloudflare-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:assets": "turbo run build --filter=assets",
    "build:image": "turbo run build --filter=image",
    "build:models": "turbo run build --filter=models",
    "build:notifications": "turbo run build --filter=notifications",
    "plan:assets": "turbo run plan --filter=assets",
    "plan:image": "turbo run plan --filter=image",
    "plan:models": "turbo run plan --filter=models",
    "plan:notifications": "turbo run plan --filter=notifications",
    "deploy:assets": "turbo run deploy --filter=assets",
    "deploy:image": "turbo run deploy --filter=image",
    "deploy:models": "turbo run deploy --filter=models",
    "deploy:notifications": "turbo run deploy --filter=notifications",
    "destroy:assets": "turbo run destroy --filter=assets",
    "destroy:image": "turbo run destroy --filter=image",
    "destroy:models": "turbo run destroy --filter=models",
    "destroy:notifications": "turbo run destroy --filter=notifications",
    "plan:github": "turbo run plan --filter=infrastructure",
    "deploy:github": "turbo run deploy --filter=infrastructure",
    "destroy:github": "turbo run destroy --filter=infrastructure",
    "bootstrap:github": "pnpm --dir stacks exec alchemy login github.ts --profile admin --configure && pnpm --dir stacks exec alchemy deploy github.ts --stage production --profile admin --yes && pnpm --dir stacks exec alchemy profile clear --profile admin",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "dev:all": "turbo run dev --parallel",
    "dev:assets": "turbo run dev --filter=assets",
    "dev:image": "turbo run dev --filter=image",
    "dev:models": "turbo run dev --filter=models",
    "dev:notifications": "turbo run dev --filter=notifications",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "cf-typegen": "turbo run cf-typegen"
  },
  "devDependencies": {
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "wrangler": "catalog:dev"
  },
  "packageManager": "pnpm@11.22.0"
}
